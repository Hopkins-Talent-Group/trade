{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/order.schema.json",
  "title": "Order record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "order_id",
    "instrument_id",
    "side",
    "quantity",
    "price",
    "status",
    "created_at",
    "source"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "order_id": { "type": "string", "minLength": 1 },
    "instrument_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "side": { "enum": ["BUY", "SELL"] },
    "quantity": { "type": "integer", "minimum": 1 },
    "price": { "$ref": "common.schema.json#/$defs/money" },
    "status": { "enum": ["pending", "filled", "partial", "cancelled", "expired"] },
    "filled_quantity": { "type": "integer", "minimum": 0 },
    "average_fill_price": { "$ref": "common.schema.json#/$defs/money" },
    "time_in_force": { "enum": ["DAY", "GTC", "IOC", "FOK"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "evidence_status": { "enum": ["user_reported", "verified", "unverified"] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "quality": { "$ref": "common.schema.json#/$defs/quality" }
  }
}
