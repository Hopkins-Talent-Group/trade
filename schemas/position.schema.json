{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/position.schema.json",
  "title": "Position state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instrument_id",
    "shares_held",
    "average_cost_per_share",
    "currency",
    "last_updated",
    "source"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "instrument_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "shares_held": { "type": "integer" },
    "average_cost_per_share": { "$ref": "common.schema.json#/$defs/money" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "open_buy_orders": { "type": "integer", "minimum": 0 },
    "open_sell_orders": { "type": "integer", "minimum": 0 },
    "available_cash": { "$ref": "common.schema.json#/$defs/money" },
    "reserved_for_orders": { "$ref": "common.schema.json#/$defs/money" },
    "exposure_percent": { "$ref": "common.schema.json#/$defs/money" },
    "maximum_acceptable_loss": { "$ref": "common.schema.json#/$defs/money" },
    "evidence_status": { "enum": ["user_reported", "verified", "unverified"] },
    "last_updated": { "$ref": "common.schema.json#/$defs/timestamp" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "quality": { "$ref": "common.schema.json#/$defs/quality" }
  }
}
